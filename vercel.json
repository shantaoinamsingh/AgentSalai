{
  "framework": "flask",
  "env": {
    "PYTHONUNBUFFERED": "1",
    "FLASK_APP": "app.py",
    "LOG_LEVEL": "INFO",
    "BROWSER_HEADLESS": "true",
    "WEB_SEARCH_FALLBACK": "false"
  },
  "functions": {
    "app.py": {
      "memory": 2048,
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/app.py" }
  ]
}
