# Copy to .env and fill in. Never commit .env.

# ─── Required ────────────────────────────────────────────────────────────────

# Azure OpenAI via the dentsu APIM gateway
AZURE_OPENAI_API_KEY=your-apim-subscription-key
AZURE_OPENAI_ENDPOINT=https://ai-api-dev.dentsu.com
AZURE_OPENAI_DEPLOYMENT_NAME=GPT4o128k
AZURE_OPENAI_API_VERSION=2024-10-21

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Gates every /admin endpoint (organisation-wide context management).
# Generate the same way as SECRET_KEY.
ADMIN_API_KEY=

# ─── APIM gateway headers ────────────────────────────────────────────────────
API_GATEWAY_VERSION=v15
API_BRAND=dentsu
API_SERVICE_LINE=Functions
API_PROJECT=test

# ─── Optional: server ────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=5000
# Leave false outside local development.
FLASK_DEBUG=false
# Set true when serving over HTTPS.
SESSION_COOKIE_SECURE=false
LOG_LEVEL=INFO

# ─── Optional: model behaviour ───────────────────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60

# ─── Optional: retrieval tuning ──────────────────────────────────────────────
# Chunks retrieved per query, and the maximum cosine distance still considered
# relevant. Lower = stricter. On the current corpus an on-topic query scores
# ~0.44 and an off-topic one ~0.93.
KB_RETRIEVAL_K=4
KB_MAX_DISTANCE=0.75
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=200

# ─── Optional: per-chat context limits ───────────────────────────────────────
MAX_UPLOAD_BYTES=52428800
MAX_CONTEXT_FILES=10
MAX_CONTEXT_CHARS_PER_FILE=40000
MAX_CONTEXT_CHARS_TOTAL=60000
MAX_HISTORY_MESSAGES=20
CHAT_TTL_SECONDS=28800

# ─── Not currently used ──────────────────────────────────────────────────────
# SharePoint / Graph integration is documented in the README as future work;
# no code reads these yet.
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# SHAREPOINT_SITE_URL=
