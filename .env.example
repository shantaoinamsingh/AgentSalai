# Copy to .env and fill in. Never commit .env.
# For production deployments, use secure values and environment-specific settings.

# ─── Required ────────────────────────────────────────────────────────────────

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: Use different values for each environment (dev, staging, production)
SECRET_KEY=

# Gates every /admin endpoint (organisation-wide context management).
# Generate the same way as SECRET_KEY.
ADMIN_API_KEY=

# ─── Server Configuration ─────────────────────────────────────────────────────
# Local development
HOST=127.0.0.1
PORT=5000

# Azure App Services / Docker - use these instead
# HOST=0.0.0.0
# PORT=8000

# ─── Security ─────────────────────────────────────────────────────────────────
# Enable only in production with HTTPS
FLASK_DEBUG=false
FLASK_ENV=development

# Set to true when serving over HTTPS (production)
SESSION_COOKIE_SECURE=false

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to DEBUG for troubleshooting (development only)

# ─── Optional: model behaviour ───────────────────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=60

# ─── Optional: retrieval tuning ──────────────────────────────────────────────
# Chunks retrieved per query, and the maximum cosine distance still considered
# relevant. Lower = stricter. On the current corpus an on-topic query scores
# ~0.44 and an off-topic one ~0.93.
KB_RETRIEVAL_K=4
KB_MAX_DISTANCE=0.75
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=200

# ─── Optional: per-chat context limits ───────────────────────────────────────
MAX_UPLOAD_BYTES=52428800
MAX_CONTEXT_FILES=10
MAX_CONTEXT_CHARS_PER_FILE=40000
MAX_CONTEXT_CHARS_TOTAL=60000
MAX_HISTORY_MESSAGES=20
CHAT_TTL_SECONDS=28800

# ─── Not currently used ──────────────────────────────────────────────────────
# SharePoint / Graph integration is documented in the README as future work;
# no code reads these yet.
# SHAREPOINT_SITE_URL=

# Browser tools: false shows a real Chrome window locally; set true on servers.
BROWSER_HEADLESS=false
MAX_TOOL_ROUNDS=15
